# Временный изолированный Debian с настоящим systemd для интеграционных тестов.
# Docker используется ТОЛЬКО в CI; VPS устанавливается обычным deploy.sh.
ARG DEBIAN_RELEASE=12
FROM debian:${DEBIAN_RELEASE}
ENV DEBIAN_FRONTEND=noninteractive container=docker
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    systemd systemd-sysv dbus sudo \
    ca-certificates curl openssl gzip tar python3 python3-yaml \
    procps iproute2 kmod cron socat util-linux \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
